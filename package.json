{
  "name": "nextjs-blog-cms",
  "version": "1.0.0",
  "description": "A modern blog CMS built with Next.js, Supabase, and TailwindCSS",
  "keywords": [
    "cms",
    "nextjs",
    "supabase",
    "tailwindcss",
    "blog"
  ],
  "homepage": "https://github.com/frank-mendez/nextjs-blog-cms#readme",
  "bugs": {
    "url": "https://github.com/frank-mendez/nextjs-blog-cms/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frank-mendez/nextjs-blog-cms.git"
  },
  "license": "MIT",
  "author": "Frank Mendez",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "prepare": "husky",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:test": "node --test scripts/check-docs.test.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "vitest related --run"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
